# Optional settings for the Tiled Map Builder MCP server.
# Copy this file to tiled-mcp/.env and uncomment what you need. Nothing here is required to
# build maps. Variables already set by your MCP client's "env" block take precedence.
# Relative paths resolve against the repository root. See docs/configuration.md.

# Where save_to_disk writes relative paths (default: <repo>/maps)
# TILED_MAPS_DIR=maps

# Sprite folder holding <theme_lowercase>/<role>.png (default: <repo>/assets)
# TILED_ASSETS_DIR=assets

# Object coordinates: "tiled" (default, Tiled's native encoding) or "screen" (legacy importers)
# TILED_OBJECT_COORDS=tiled

# --- Paid sprite generation (FLUX.1-dev via Hugging Face). See docs/sprite-generation.md ---
# HUGGINGFACE_API_KEY=hf_xxx
# TILED_HF_PROVIDER=replicate

# Note: NVIDIA_API_KEY is not read by this server. Configure it in the agent that uses
# Nemotron (see docs/nemotron.md).
